name: "segformer_b2"
platform: "onnxruntime_onnx"
max_batch_size: 8
input [
  { name: "INPUT__0" data_type: TYPE_FP32 dims: [ 4, 1024, 1024 ] }
]
output [
  { name: "OUTPUT__0" data_type: TYPE_FP32 dims: [ 1, -1, -1 ] }
]
instance_group [
  { kind: KIND_GPU count: 1 }
]
dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 50000
}
