{
  "uid": "mlsystem-airflow",
  "title": "MLSystem Airflow",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["mlsystem", "airflow"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Scheduler Healthy", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "airflow_scheduler_healthy", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Running DAG Runs", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(airflow_dag_run_state{state=\"running\"})", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Failed DAG Runs", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(airflow_dag_run_state{state=\"failed\"})", "refId": "A"}]},
    {"id": 10, "type": "state-timeline", "title": "Recent DAG Run States", "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "airflow_dag_run_state", "legendFormat": "{{run_id}} {{state}}", "refId": "A"}]},
    {"id": 11, "type": "state-timeline", "title": "Task States", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "airflow_task_state", "legendFormat": "{{task_id}} {{state}}", "refId": "A"}]},
    {"id": 12, "type": "timeseries", "title": "Task Duration", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "airflow_task_duration_seconds", "legendFormat": "{{task_id}}", "refId": "A"}]}
  ]
}
