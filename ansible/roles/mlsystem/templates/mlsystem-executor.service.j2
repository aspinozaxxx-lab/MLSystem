[Unit]
Description=MLSystem YAML queue executor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/worker/mlsystem
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/worker/ml-training/.venv/bin/python -m src.cli run-forever --interval 10
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
