[Unit]
Description=MLSystem FastAPI status API
After=network-online.target

[Service]
Type=simple
User=worker
Group=worker
WorkingDirectory=/home/worker/mlsystem
EnvironmentFile=/etc/mlsystem/mlsystem.env
ExecStart=/home/worker/ml-training/.venv/bin/python -m src.web_app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
