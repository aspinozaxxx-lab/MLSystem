services:
  airflow-postgres:
    image: postgres:15
    container_name: mlsystem-airflow-postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-airflow}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-airflow}
    volumes:
      - {{ airflow_postgres_data_root }}:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-airflow}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{ mlsystem_airflow_network }}

  airflow-init:
    image: ${AIRFLOW_IMAGE:-{{ airflow_image }}}
    container_name: mlsystem-airflow-init
    depends_on:
      airflow-postgres:
        condition: service_healthy
    env_file:
      - {{ airflow_env_path }}
    user: "0:0"
    entrypoint: /bin/bash
    command:
      - -c
      - |
        mkdir -p /opt/airflow/logs /opt/airflow/dags /opt/airflow/plugins /opt/airflow/mlsystem_runs
        chown -R "${AIRFLOW_UID}:0" /opt/airflow/logs /opt/airflow/dags /opt/airflow/plugins /opt/airflow/mlsystem_runs
        airflow db migrate
        airflow users create \
          --username "${_AIRFLOW_WWW_USER_USERNAME}" \
          --password "${_AIRFLOW_WWW_USER_PASSWORD}" \
          --firstname "${_AIRFLOW_WWW_USER_FIRSTNAME}" \
          --lastname "${_AIRFLOW_WWW_USER_LASTNAME}" \
          --role Admin \
          --email "${_AIRFLOW_WWW_USER_EMAIL}" || true
        airflow pools set gpu_training "{{ airflow_gpu_slots }}" "GPU-bound MLSystem train/inference stages"
        airflow pools set cpu_heavy "{{ airflow_cpu_heavy_slots }}" "CPU-heavy MLSystem vectorization/postprocess stages"
        airflow pools set cpu_light "{{ airflow_cpu_light_slots }}" "Lightweight MLSystem orchestration stages"
        airflow pools set io_light "{{ airflow_io_light_slots }}" "Lightweight S3/MLflow IO stages"
    volumes:
      - {{ airflow_dags_root }}:/opt/airflow/dags
      - {{ airflow_logs_root }}:/opt/airflow/logs
      - {{ airflow_plugins_root }}:/opt/airflow/plugins
      - {{ airflow_include_root }}:/opt/airflow/include
      - {{ airflow_status_root }}:/opt/airflow/mlsystem_runs
      - {{ mlsystem_root }}:/opt/mlsystem
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - {{ mlsystem_airflow_network }}

  airflow-webserver:
    image: ${AIRFLOW_IMAGE:-{{ airflow_image }}}
    container_name: mlsystem-airflow-webserver
    depends_on:
      airflow-postgres:
        condition: service_healthy
    env_file:
      - {{ airflow_env_path }}
    environment:
      PYTHONPATH: /opt/mlsystem
    command: webserver
    ports:
      - "{{ airflow_webserver_port }}:8080"
    volumes:
      - {{ airflow_dags_root }}:/opt/airflow/dags
      - {{ airflow_logs_root }}:/opt/airflow/logs
      - {{ airflow_plugins_root }}:/opt/airflow/plugins
      - {{ airflow_include_root }}:/opt/airflow/include
      - {{ airflow_status_root }}:/opt/airflow/mlsystem_runs
      - {{ mlsystem_root }}:/opt/mlsystem
      - {{ mlsystem_data_root }}:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: ["CMD-SHELL", "curl --fail http://localhost:8080/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - {{ mlsystem_airflow_network }}

  airflow-scheduler:
    image: ${AIRFLOW_IMAGE:-{{ airflow_image }}}
    container_name: mlsystem-airflow-scheduler
    depends_on:
      airflow-postgres:
        condition: service_healthy
    env_file:
      - {{ airflow_env_path }}
    environment:
      PYTHONPATH: /opt/mlsystem
    command: scheduler
    volumes:
      - {{ airflow_dags_root }}:/opt/airflow/dags
      - {{ airflow_logs_root }}:/opt/airflow/logs
      - {{ airflow_plugins_root }}:/opt/airflow/plugins
      - {{ airflow_include_root }}:/opt/airflow/include
      - {{ airflow_status_root }}:/opt/airflow/mlsystem_runs
      - {{ mlsystem_root }}:/opt/mlsystem
      - {{ mlsystem_data_root }}:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: ["CMD-SHELL", "airflow jobs check --job-type SchedulerJob --hostname \"$${HOSTNAME}\""]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - {{ mlsystem_airflow_network }}

  airflow-triggerer:
    image: ${AIRFLOW_IMAGE:-{{ airflow_image }}}
    container_name: mlsystem-airflow-triggerer
    depends_on:
      airflow-postgres:
        condition: service_healthy
    env_file:
      - {{ airflow_env_path }}
    environment:
      PYTHONPATH: /opt/mlsystem
    command: triggerer
    volumes:
      - {{ airflow_dags_root }}:/opt/airflow/dags
      - {{ airflow_logs_root }}:/opt/airflow/logs
      - {{ airflow_plugins_root }}:/opt/airflow/plugins
      - {{ airflow_include_root }}:/opt/airflow/include
      - {{ airflow_status_root }}:/opt/airflow/mlsystem_runs
      - {{ mlsystem_root }}:/opt/mlsystem
      - {{ mlsystem_data_root }}:/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - {{ mlsystem_airflow_network }}

networks:
  {{ mlsystem_airflow_network }}:
    driver: bridge
