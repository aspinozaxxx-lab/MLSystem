map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name {{ mlsystem_gpu_public_host | default('31.192.104.147') }} _;

    client_max_body_size {{ mlsystem_gpu_frontend_max_upload_mb | default(100) + 28 }}m;
    resolver 127.0.0.11 ipv6=off valid=10s;

    proxy_intercept_errors on;
    error_page 401 = @frontend_login;

    location @frontend_login {
        return 302 /login;
    }

    location = /auth/proxy-check {
        proxy_intercept_errors off;
        proxy_pass http://mlsystem-frontend:{{ mlsystem_gpu_frontend_port | default(8090) }}/auth/proxy-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /mlflow/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $mlflow_upstream mlflow:5000;

        proxy_pass http://$mlflow_upstream;
        proxy_http_version 1.1;
        proxy_redirect / /mlflow/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /mlflow;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /rabbitmq/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $rabbitmq_upstream rabbitmq:15672;

        proxy_pass http://$rabbitmq_upstream;
        proxy_http_version 1.1;
        proxy_redirect /rabbitmq/ /rabbitmq/;

{% if frontend_rabbitmq_proxy_basic_auth | default('') %}
        proxy_set_header Authorization "Basic {{ frontend_rabbitmq_proxy_basic_auth }}";
{% endif %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /rabbitmq;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location = /minio {
        auth_request /auth/proxy-check;
        return 301 /minio/;
    }

    location /minio/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $minio_console_upstream http://minio:{{ mlsystem_gpu_minio_console_port | default(9001) }};
        rewrite ^/minio/(.*)$ /$1 break;

        proxy_pass $minio_console_upstream;
        proxy_http_version 1.1;
        proxy_redirect / /minio/;
        proxy_cookie_path / /minio/;
        proxy_set_header Accept-Encoding "";
        sub_filter '<base href="/"/>' '<base href="/minio/"/>';
        sub_filter_once on;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /minio;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /grafana/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $grafana_upstream grafana:3000;

        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_redirect http://grafana:3000/grafana/ /grafana/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /grafana;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /prometheus/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $prometheus_upstream prometheus:9090;

        proxy_pass http://$prometheus_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /prometheus;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /jupyter/ {
        auth_request /auth/proxy-check;
        auth_request_set $auth_user $upstream_http_x_remote_user;
        set $jupyter_upstream mlsystem-gpu-jupyter:8888;

        proxy_pass http://$jupyter_upstream;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /jupyter;
        proxy_set_header X-Remote-User $auth_user;
        proxy_set_header X-MLSystem-User $auth_user;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 86400s;
    }

    location / {
        proxy_pass http://mlsystem-frontend:{{ mlsystem_gpu_frontend_port | default(8090) }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
