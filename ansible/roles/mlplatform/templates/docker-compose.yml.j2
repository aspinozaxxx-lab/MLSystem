services:
  minio:
    image: {{ mlplatform_minio_image }}
    container_name: mlplatform-minio
    command: server --console-address :9001 /data
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - {{ mlplatform_minio_data_path }}:/data
    healthcheck:
      test: ["CMD-SHELL", "mc ready local"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - ml-platform-net

  mlflow-db:
    image: {{ mlplatform_postgres_image }}
    container_name: mlplatform-mlflow-db
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-mlflow}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-mlflow}
    volumes:
      - mlflow-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-mlflow}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - ml-platform-net

  mlflow:
    image: {{ mlplatform_mlflow_image }}
    container_name: mlplatform-mlflow
    depends_on:
      minio:
        condition: service_healthy
      mlflow-db:
        condition: service_healthy
    environment:
      MLFLOW_S3_ENDPOINT_URL: "http://minio:9000"
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
      AWS_DEFAULT_REGION: ${AWS_DEFAULT_REGION:-us-east-1}
      AWS_S3_ADDRESSING_STYLE: path
      AWS_S3_FORCE_PATH_STYLE: "true"
      MLFLOW_SERVER_DISABLE_SECURITY_MIDDLEWARE: "true"
      MLFLOW_ARTIFACTS_DESTINATION: "${MLFLOW_ARTIFACT_ROOT:-s3://mlflow-artifacts}"
      MLFLOW_HOST: "0.0.0.0"
    entrypoint: >
      bash -c "pip install --no-cache-dir psycopg2-binary boto3 &&
               mlflow server
               --backend-store-uri postgresql+psycopg2://${POSTGRES_USER:-mlflow}:${POSTGRES_PASSWORD}@mlflow-db:5432/${POSTGRES_DB:-mlflow}
               --default-artifact-root mlflow-artifacts:/
               --serve-artifacts
               --artifacts-destination ${MLFLOW_ARTIFACT_ROOT:-s3://mlflow-artifacts}
               --host 0.0.0.0
               --port ${MLFLOW_PORT:-5000}
               --disable-security-middleware"
    ports:
      - "${MLFLOW_PORT:-{{ mlplatform_mlflow_port }}}:${MLFLOW_PORT:-{{ mlplatform_mlflow_port }}}"
    healthcheck:
      test: ["CMD-SHELL", "python3 -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:${MLFLOW_PORT:-5000}/health\")'"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - ml-platform-net

{% if mlplatform_include_streamlit | bool %}
  streamlit-ui:
    build:
      context: ./services/streamlit-app
      dockerfile: Dockerfile
    container_name: mlplatform-streamlit-ui
    depends_on:
      minio:
        condition: service_healthy
      mlflow:
        condition: service_healthy
    environment:
      MLFLOW_TRACKING_URI: ${MLFLOW_TRACKING_URI:-http://mlflow:5000}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
      MLFLOW_S3_ENDPOINT_URL: ${MLFLOW_S3_ENDPOINT_URL:-http://minio:9000}
      STREAMLIT_MODEL_NAME: ${STREAMLIT_MODEL_NAME:-segmentation_model}
      STREAMLIT_MODEL_STAGE: ${STREAMLIT_MODEL_STAGE:-Production}
      STREAMLIT_MODEL_VERSION: ${STREAMLIT_MODEL_VERSION:-1}
      STREAMLIT_FALLBACK_WEIGHTS: ${STREAMLIT_FALLBACK_WEIGHTS:-models/dev_model.pth}
    ports:
      - "${STREAMLIT_PORT:-8080}:8501"
    volumes:
      - ./services/streamlit-app/models:/app/models:ro
    networks:
      - ml-platform-net
{% endif %}

volumes:
  mlflow-db-data:

networks:
  ml-platform-net:
    driver: bridge
